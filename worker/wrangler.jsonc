// Cloudflare Worker do CensoSenso MCP.
// Produção canônica exclusivamente em censosenso.poderdapalavra.org.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "censosenso-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "censosenso.poderdapalavra.org",
      "custom_domain": true
    }
  ],

  "vars": {
    "ALLOWED_ORIGIN": "*"
  },

  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageTracker"] }],

  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
